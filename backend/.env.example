# Banco de dados (SQLite local — arquivo gerado em prisma/dev.db)
DATABASE_URL="file:./dev.db"

# Segredo usado para assinar tokens JWT — gere um valor forte em produção
# Ex: openssl rand -base64 48
JWT_SECRET="troque-este-valor-por-um-segredo-forte-em-producao"
JWT_EXPIRES_IN="7d"

# Porta do servidor HTTP
PORT=3333

# Origem permitida para CORS (URL do frontend)
CORS_ORIGIN="http://localhost:5173"

NODE_ENV="development"
